.ruff_cache/
.coverage
htmlcov/

# ===== Notebook =====
.ipynb_checkpoints/

# ===== Dữ liệu (không commit dữ liệu thô, embedding, đặc trưng đã xử lý) =====
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# data/splits/ được commit: chỉ số leave-last-out dùng chung cho mọi mô hình

# ===== Checkpoint, embedding, chỉ mục =====
checkpoints/
saved/
log_tensorboard/
runs/
wandb/
lightning_logs/
