*.pth
*.ckpt
*.safetensors
*.bin
*.npy
*.npz
*.faiss
*.index
*.pkl
*.pickle
*.h5
*.parquet
*.json.gz
*.gz

# Ngoại lệ: file chỉ số chia dữ liệu nhỏ, dùng chung
!data/splits/*.npy
!data/splits/*.npz

# ===== Cache của thư viện =====
.cache/
.huggingface/
.recbole/

# ===== Kết quả thí nghiệm sinh tự động =====
# experiments/log.csv được commit; các file sinh thêm thì không
experiments/*
!experiments/log.csv
!experiments/.gitkeep

# ===== Báo cáo xuất file =====
reports/*.pdf
reports/*.docx
reports/*.pptx

